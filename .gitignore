# ==============================================================================
# Git Ignore Configuration
# Protects secrets, credentials, dependencies, and environment-specific files
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (CRITICAL: Never commit API keys or credentials)
# ------------------------------------------------------------------------------
.env
.ev
*.env
*.ev
*.env.*
*.ev.*
*.env.local
*.ev.local
.env.development.local
.env.test.local
.env.production.local

# Specific folder environments
backend/.env*
backend/.ev*
frontend/.env*
frontend/.ev*

# Allow example/template files to be committed safely
!.env.example
!.ev.example
!backend/.env.example
!backend/.ev.example
!frontend/.env.example
!frontend/.ev.example

# Secret keys, certificates, service account tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
serviceAccountKey.json

# ------------------------------------------------------------------------------
# 2. Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnp/
.pnp.js

# ------------------------------------------------------------------------------
# 3. Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. OS-Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ------------------------------------------------------------------------------
# 5. IDE, Editor & Workspace Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.swn
.project
.classpath
.settings/

# ------------------------------------------------------------------------------
# 6. Build, Cache & Temporary Directories
# ------------------------------------------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
tmp/
temp/
.temp/
scratch/

# ------------------------------------------------------------------------------
# 7. Testing & Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
.turbo/
